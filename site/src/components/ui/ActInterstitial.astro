---
interface Props {
  act: string;      // "Act I"
  title: string;
  subtitle?: string;
  id?: string;
}
const { act, title, subtitle, id } = Astro.props;
---

<section class="act" id={id} data-act={act}>
  <div class="act-inner reveal">
    <p class="act-kicker">{act}</p>
    <h2 class="act-title">{title}</h2>
    {subtitle && <p class="act-sub">{subtitle}</p>}
  </div>
  <div class="act-grid" aria-hidden="true"></div>
</section>

<style>
  .act {
    position: relative;
    min-height: 62vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    border-block: 1px solid var(--hairline);
    background:
      radial-gradient(80% 120% at 50% 0%, rgba(34,211,238,0.08), transparent 60%),
      radial-gradient(80% 120% at 50% 100%, rgba(168,85,247,0.10), transparent 60%);
  }
  .act-grid {
    position: absolute; inset: 0; z-index: 0; opacity: 0.5;
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(70% 60% at 50% 50%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 50%, #000 0%, transparent 75%);
  }
  .act-inner { position: relative; z-index: 1; max-width: 760px; padding: 2rem 1.25rem; }
  .act-kicker {
    font-family: var(--font-mono); letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--cyan); font-size: 0.85rem; margin: 0 0 1rem;
  }
  .act-title { font-size: clamp(2rem, 6vw, 3.6rem); margin: 0; line-height: 1.08; }
  .act-sub { margin: 1.2rem auto 0; max-width: 52ch; color: var(--ink-soft); font-size: 1.12rem; line-height: 1.6; }
</style>
