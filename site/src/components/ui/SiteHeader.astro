---
import { AUTHOR, activeLinks } from '../../data/links';
const primary = activeLinks('primary');
---

<header class="site-header">
  <div class="sh-inner">
    <a class="sh-brand" href="#top">
      <span class="sh-mark" aria-hidden="true"></span>
      <span class="sh-name">{AUTHOR.name}</span>
      <span class="sh-tag">{AUTHOR.tagline}</span>
    </a>
    <nav class="sh-links" aria-label="Resources">
      {primary.map((l) => (
        <a class="sh-primary" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
      ))}
      <a class="sh-social" href="#about-author">About the author</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--hairline);
  }
  .sh-inner {
    max-width: var(--maxw-wide);
    margin-inline: auto;
    padding: 0.55rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .sh-brand { display: flex; align-items: baseline; gap: 0.55rem; border-bottom: none; text-decoration: none; }
  .sh-mark {
    width: 12px; height: 12px; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, var(--cyan), var(--violet));
    box-shadow: var(--glow-cyan); align-self: center; flex: none;
  }
  .sh-name { color: var(--ink); font-weight: 650; font-size: 0.95rem; }
  .sh-tag { color: var(--ink-faint); font-size: 0.78rem; font-family: var(--font-mono); }
  .sh-links { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end; }
  .sh-primary {
    font-size: 0.8rem; padding: 0.32rem 0.7rem; border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent);
    color: var(--ink); text-decoration: none; white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .sh-primary:hover { background: color-mix(in srgb, var(--cyan) 14%, transparent); border-color: var(--cyan); }
  .sh-divider { width: 1px; height: 18px; background: var(--hairline); }
  .sh-social { font-size: 0.78rem; color: var(--ink-soft); text-decoration: none; padding: 0.2rem 0.35rem; }
  .sh-social:hover { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 720px) {
    .sh-tag { display: none; }
    .sh-inner { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .sh-links { justify-content: flex-start; }
  }
</style>
