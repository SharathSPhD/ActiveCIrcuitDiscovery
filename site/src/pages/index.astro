    .step-flow-wrap { max-width: 520px; margin: 1rem auto 0; }

    .hyp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.2rem; }
    .why-list { color: var(--ink-soft); display: flex; flex-direction: column; gap: 0.7rem; padding-left: 1.1rem; margin-top: 1.2rem; }

    .bigstat-row { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1.4rem 0; }
    .bigstat { flex: 1; min-width: 150px; border: 1px solid var(--hairline); border-radius: var(--radius); padding: 1.1rem; background: var(--bg-panel); text-align: center; }
