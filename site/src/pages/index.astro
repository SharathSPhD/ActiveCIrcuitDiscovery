    .hero-copy { position: relative; z-index: 1; padding-block: 4rem; }
    .kicker { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan); margin: 0 0 1rem; }
    .hero h1 { font-size: clamp(2.4rem, 7vw, 4.4rem); margin: 0 0 1.3rem; line-height: 1.05; text-shadow: 0 2px 40px rgba(10,14,20,0.85); }
    .hero .lead { max-width: 40ch; font-size: clamp(1.05rem, 2.4vw, 1.3rem); color: var(--ink); }
    .byline { margin-top: 1.4rem; color: var(--ink-soft); font-size: 0.95rem; }
    .scroll-hint { margin-top: 2rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-faint); letter-spacing: 0.1em; }

    .exemplar { font-size: 1.15rem; color: var(--ink); background: var(--bg-inset); border-left: 3px solid var(--cyan);
      padding: 0.9rem 1.1rem; border-radius: 8px; margin: 1.2rem 0; }
    .two-drives { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; margin: 1rem 0; }
    .two-drives li { color: var(--ink-soft); font-size: 1.05rem; }
    .two-drives span { font-weight: 650; }

    .iv-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; margin: 1.4rem 0; }
    .iv { border: 1px solid var(--hairline); border-left-width: 3px; border-radius: var(--radius); background: var(--bg-panel); padding: 1rem; }
    .iv h4 { margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; color: var(--ink); }
    .iv .d { width: 11px; height: 11px; border-radius: 3px; }
