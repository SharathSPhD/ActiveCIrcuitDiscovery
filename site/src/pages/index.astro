---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollScene from '../components/ui/ScrollScene.astro';
import ActInterstitial from '../components/ui/ActInterstitial.astro';
import StickyScrolly from '../components/ui/StickyScrolly.astro';
import DeepDive from '../components/ui/DeepDive.astro';
import Callout from '../components/ui/Callout.astro';
import MathDisplay from '../components/ui/MathDisplay.astro';
import HypothesisCard from '../components/ui/HypothesisCard.astro';
import CitationList from '../components/ui/CitationList.astro';
import ParticleBrain from '../components/charts/ParticleBrain.tsx';
import NeuralGraph from '../components/charts/NeuralGraph.tsx';
import AgentTimeline from '../components/charts/AgentTimeline.tsx';
import EfficiencyExplorer from '../components/charts/EfficiencyExplorer.tsx';
import RckPanel from '../components/charts/RckPanel.tsx';
import SteeringPanel from '../components/charts/SteeringPanel.tsx';
import DomainPanel from '../components/charts/DomainPanel.tsx';
import EFEChooser from '../components/charts/EFEChooser.tsx';
import FlowDiagram from '../components/charts/FlowDiagram.tsx';
import { architecture, aiLoop, stepFlow } from '../components/charts/paperDiagrams';
import { HEADLINE } from '../data';
import { REFS, READING_ORDER } from '../data/refs';
import { AUTHOR } from '../data/links';
import { fmtPct } from '../utils/math';

const reading = READING_ORDER.map((k) => REFS[k]);
const E = (x: number) => fmtPct(x);

const fepTex = String.raw`F \;=\; \underbrace{D_{\mathrm{KL}}\!\big[\,q(s)\,\Vert\,p(s\mid o)\,\big]}_{\text{approximation error}} \;-\; \underbrace{\log p(o)}_{\text{surprise}}`;
const efeTex = String.raw`\mathcal{G}(\pi)=\underbrace{-\,\mathbb{E}_{q}\big[\,D_{\mathrm{KL}}[\,q(s\mid o,\pi)\,\Vert\,q(s\mid\pi)\,]\,\big]}_{\text{epistemic · information gain}}\;\;\underbrace{-\,\mathbb{E}_{q}\big[\log p(o)\big]}_{\text{pragmatic · preference}}`;
---

<BaseLayout>
  {/* ============================== HERO ============================== */}
  <section id="hook" class="hero" data-scene="hook">
    <div class="hero-canvas"><ParticleBrain client:visible height={560} /></div>
    <div class="hero-copy reading">
      <p class="kicker">An interactive essay · Active Circuit Discovery</p>
      <h1>A Neuroscientist's Tool<br />to Pick AI's Brain</h1>
      <p class="lead">
        We trust large language models to write, reason, and decide — yet we can barely see how they do
        it. This is the story of an agent that borrows a 30-year-old theory of the <em>brain</em> to hunt,
        one experiment at a time, for the circuits hidden inside an AI's mind.
      </p>
      <p class="byline">by <strong>{AUTHOR.name}</strong> · a guided tour for the curious and the technical alike</p>
      <p class="scroll-hint" aria-hidden="true">scroll to begin ↓</p>
    </div>
  </section>

  {/* ============================== ACT I ============================== */}
  <ActInterstitial act="Act I" title="The Black Box" subtitle="We grew these minds. We never learned to read them." />

  <ScrollScene id="blackbox" num={2} eyebrow="The problem" title="We built it. We can't read it.">
    <p class="lead">
      Here is the strange truth at the heart of modern AI: nobody <em>designed</em> a large language
      model's behaviour. We designed a <strong>learning process</strong>, poured in much of the internet,
      and a mind precipitated out — billions of numbers that somehow know grammar, geography, and how to
      code. We can run it. We can't open it.
    </p>
    <p>
      It's the difference between an engineer's blueprint and a biologist's specimen. A circuit board is
      <em>designed</em>; you can read its schematic. A brain is <em>grown</em>; you have to dissect it to
      learn how it works. Today's models are far closer to the brain: grown, not authored.
    </p>
    <Callout kind="key" label="Why care?">
      <p>
        If we can't see inside, we can't tell a model that is <em>right for the right reasons</em> from one
        that has learned to <em>look</em> right — or one quietly planning to behave differently once
        deployed. Reading the machinery is how auditing, debugging, and safety become possible at all.
      </p>
    </Callout>
    <DeepDive title="Just how opaque is it, really?">
      <p>
        A frontier model holds <strong>hundreds of billions</strong> of parameters. The natural unit to
        inspect — the neuron — is <em>polysemantic</em>: a single neuron fires for dozens of unrelated
        concepts at once, because the network packs far more features than it has neurons (a phenomenon
        called <em>superposition</em>). Behavioural testing — "red-teaming" — samples outputs but never
        reveals mechanism, the way a crash test never explains the engine. Regulators have noticed: the
        EU AI Act and NIST's AI risk framework both lean on transparency the field cannot yet deliver.
      </p>
    </DeepDive>
  </ScrollScene>

  {/* ============================== ACT II ============================== */}
  <ActInterstitial act="Act II" title="A Microscope for Minds" subtitle="Mechanistic interpretability: reverse-engineering thought into parts you can name." />

  <ScrollScene id="microscope" num={3} eyebrow="Mechanistic interpretability" title="A microscope for artificial minds" wide>
    <p class="lead">
      A small field is building that microscope. <strong>Mechanistic interpretability</strong> treats a
      trained network like an organism to be reverse-engineered: find the internal <em>features</em> it
      represents, and the <em>circuits</em> that wire those features into behaviour.
    </p>
    <p>
      The first surprise is that there's structure to find at all. In vision models, researchers found
      neurons for curves, then circuits that assemble curves into car wheels. The same playbook moved to
      language. But there's a catch: look at a single neuron and you'll see nonsense — it lights up for
      "the Golden Gate Bridge," "Python errors," and "the year 1987." Concepts are <em>superposed</em>.
    </p>
    <p>
      The fix is a kind of prism. A <strong>sparse autoencoder</strong> (or transcoder) decomposes the
      tangled activations back into many clean, single-meaning features — one for the Golden Gate Bridge,
      one for Python errors, and so on. This is the picture below: a real attribution graph (the haystack
      of features), trimmed to the most influential.
    </p>

    <NeuralGraph client:visible height={520} />

    <Callout kind="note" label="It really is causal">
      <p>
        When Anthropic amplified a single "Golden Gate Bridge" feature, Claude became
        <em> obsessed</em> — asked how to spend $10, it suggested driving across the bridge. Proof that
        these features aren't just correlations; turning one up <em>changes what the model does</em>.
      </p>
    </Callout>

    <DeepDive title="Features, superposition, and dictionary learning">
      <p>
        A model with hidden width <em>d</em> can represent <em>D ≫ d</em> features by placing them as
        nearly-orthogonal directions in activation space — superposition. Polysemantic neurons are the
        symptom. <strong>Sparse autoencoders</strong> (Bricken et al. 2023; Cunningham et al. 2024) learn an
        overcomplete dictionary of directions with an L1/JumpReLU sparsity penalty, recovering
        <em>monosemantic</em> features; <strong>transcoders</strong> extend this to predict the next layer,
        letting you trace features <em>across</em> layers. Gemma Scope (Lieberum et al. 2024) released
        millions of such features for Gemma 2 — the exact backend this paper builds on.
      </p>
    </DeepDive>
  </ScrollScene>

  <ScrollScene id="circuit" num={4} eyebrow="A worked example" title="Features, circuits, and the name-mover">
    <p class="lead">
      Make it concrete with the field's fruit-fly task — and the very prompt this paper probes:
    </p>
    <p class="exemplar mono">"When John and Mary went to the store, John gave the bag to ___"</p>
    <p>
      You answered <strong>Mary</strong> without thinking. So does the model — and in GPT-2 researchers
      mapped <em>exactly how</em>. A circuit of ~26 attention heads cooperates: some heads notice that
      "John" appears twice, others <em>inhibit</em> that repeated name, and a special group — the
      <strong> "name-mover heads"</strong> — copy the <em>other</em> name to the output. Ablate them and
      accuracy collapses from ~90% to chance. That is a circuit: a minimal, causal, nameable mechanism.
    </p>
    <Callout kind="key" label="The point">
      <p>
        A circuit isn't a metaphor. It's a specific subgraph of features whose activity is
        <em> necessary and sufficient</em> for a behaviour — something you can locate, draw, and break.
      </p>
    </Callout>
    <DeepDive title="The IOI circuit (Wang et al. 2022)">
      <p>
        Indirect Object Identification spans all 12 layers of GPT-2 small: duplicate-token heads →
        inhibition heads → name-mover heads at layers 9–11 attending from the final position to the
        indirect-object token, copying it to the logits. ~6 "backup" heads provide redundancy, which is
        why single-head ablations often barely dent performance — a recurring theme in real circuits.
      </p>
    </DeepDive>
  </ScrollScene>

  <ScrollScene id="testing" num={5} eyebrow="The method behind the microscope" title="How you prove a part matters">
    <p class="lead">
      How do you show a part is <em>causal</em>, not just present? The same way a mechanic tests a theory
      about spark plugs — interfere, and watch what breaks. Three interventions, increasingly gentle:
    </p>

    <div class="iv-cards">
      <div class="iv" style="border-left-color:var(--action-ablation)">
        <h4><span class="d" style="background:var(--action-ablation)"></span>Ablation</h4>
        <p>Switch the feature off entirely. The bluntest, most <em>informative</em> probe — like pulling the spark plug to see if the engine dies.</p>
      </div>
      <div class="iv" style="border-left-color:var(--action-patching)">
        <h4><span class="d" style="background:var(--action-patching)"></span>Patching</h4>
        <p>Replace its value with one from a different run. A precise, confirmatory swap — does <em>this</em> signal carry <em>that</em> effect?</p>
      </div>
      <div class="iv" style="border-left-color:var(--action-steering)">
        <h4><span class="d" style="background:var(--action-steering)"></span>Steering</h4>
        <p>Amplify it. The gentlest nudge — turn it up and see how far behaviour bends (this is how Golden Gate Claude was made).</p>
      </div>
    </div>

    <p>
      The yardstick throughout is <strong>KL divergence</strong>: a number for how much the model's
      output distribution <em>moved</em> after the intervention. Big move ⇒ the part mattered.
    </p>
    <DeepDive title="Ablation vs activation patching vs causal scrubbing">
      <p>
        Ablation (zero or mean) measures necessity but can knock the model off-distribution. Activation
        patching (Meng et al.; Syed et al. 2023) swaps a clean activation into a corrupted run (or vice
        versa) for a sharper causal estimate. Causal scrubbing stress-tests a hypothesised circuit by
        resampling everything <em>outside</em> it. All reduce to one question: does intervening
        <em> here</em> change the output, measured as KL between clean and intervened logits?
      </p>
    </DeepDive>
  </ScrollScene>

  {/* ============================== ACT III ============================== */}
  <ActInterstitial act="Act III" title="The Brain That Predicts" subtitle="To choose the next experiment well, borrow how a brain copes with not-knowing." />

  <ScrollScene id="predict" num={6} eyebrow="A clue from neuroscience" title="The brain that predicts">
    <p class="lead">
      Step away from AI for a moment. Cover half a line of text on your phone with your thumb — you still
      "see" the whole sentence. Your brain didn't photograph the words; it <strong>predicted</strong> them
      and showed you the guess. You only notice when a prediction is wrong.
    </p>
    <p>
      This is the <strong>brain-as-prediction-machine</strong> view, and its boldest formulation is Karl
      Friston's <strong>Free Energy Principle</strong>: living systems act to minimise <em>surprise</em> —
      the gap between what they predict and what they sense. Perception updates the model; action changes
      the world to match the model. Both reduce the same quantity.
    </p>
    <Callout kind="note" label="The dark-room puzzle">
      <p>
        If you only wanted to minimise surprise, why not sit in a silent dark room forever? Because your
        model <em>expects</em> a rich, changing world — and a dark room is, after a moment, intensely
        surprising. Resolving that expectation is exactly what makes curiosity rational.
      </p>
    </Callout>
    <DeepDive title="Free energy, precisely">
      <p>
        "Surprise" (<em>−log p(o)</em>) is intractable, so the brain minimises a tractable upper bound —
        <strong> variational free energy</strong> — by keeping an internal belief <em>q(s)</em> close to the
        true posterior <em>p(s|o)</em>:
      </p>
      <MathDisplay tex={fepTex} />
      <p>
        Minimise <em>F</em> by changing beliefs (perception) <em>or</em> by acting to change observations
        (active inference). See Friston (2010) and Parr, Pezzulo &amp; Friston (2022).
      </p>
    </DeepDive>
  </ScrollScene>

  <ScrollScene id="efe" num={7} eyebrow="The crux" title="One equation for curiosity" wide>
    <p class="lead">
      Now the idea that makes everything click. When an active-inference agent weighs an action, it scores
      it on <strong>two</strong> things at once — and a single quantity, <strong>Expected Free Energy</strong>,
      combines them:
    </p>
    <ul class="two-drives">
      <li><span class="accent-cyan">Will it teach me something?</span> — <em>epistemic</em> value (information gain).</li>
      <li><span class="accent-violet">Will it get me what I want?</span> — <em>pragmatic</em> value (preference).</li>
    </ul>
    <p>
      That's the whole explore-vs-exploit dilemma, resolved by one rule. Think of a student picking a
      class: <em>photography</em> (loved, but nothing new) versus <em>philosophy</em> (uncertain, but
      transformative). A good agent weighs both. Drag the slider — watch which experiment the agent prefers
      as its <strong>uncertainty</strong> changes:
    </p>

    <EFEChooser client:visible />

    <Callout kind="key" label="The bridge">
      <p>
        Here is the leap this paper makes. "Which intervention should I run next on a neural network?" is
        <em> exactly</em> this problem. Treat the unknown circuit as the hidden state, each experiment as an
        action, and let Expected Free Energy choose. Curiosity becomes an algorithm for interpretability.
      </p>
    </Callout>

    <DeepDive title="Expected Free Energy, the math (and what's genuinely new)">
      <p>EFE scores a policy by expected information gain plus expected preference:</p>
      <MathDisplay tex={efeTex} />
      <p>
        Minimising the epistemic term means choosing experiments whose outcomes you <em>can't</em> yet
        predict — the most informative ones (MacKay 2003's optimal experimental design, recovered from
        first principles). The agent is built on discrete active inference (Da Costa et al. 2020) via the
        <span class="mono"> pymdp</span> library (Heins et al. 2022), and <em>learns</em> its observation
        model online with Dirichlet (conjugate) updates. What's genuinely novel here isn't any single
        ingredient — it's wiring them into one loop for circuit discovery.
      </p>
    </DeepDive>
  </ScrollScene>

  {/* ============================== ACT IV ============================== */}
  <ActInterstitial act="Act IV" title="The Meeting Point" subtitle="Active Circuit Discovery: an agent that picks its next experiment the way a brain would." />

  <ScrollScene id="method" num={8} eyebrow="The architecture" title="An agent that experiments on a mind" wide>
    <p class="lead">
      Two halves click together. A <span class="accent-cyan">backend</span> builds the haystack — an
      attribution graph of candidate features. An <span class="accent-violet">Active-Inference agent</span>
      then decides, step by step, which feature to probe and how.
    </p>

    <FlowDiagram client:visible testid="dg-architecture" ariaLabel="Active Circuit Discovery architecture: attribution-graph backend feeding an Active-Inference POMDP agent loop"
      viewW={architecture.viewW} viewH={architecture.viewH} nodes={architecture.nodes} edges={architecture.edges} groups={architecture.groups}
      caption="The ACD architecture — recreated from the paper. Cyan particles trace the flow of data; the dashed violet edge is the feedback loop that lets each experiment reshape the next choice." />

    <p>
      The agent holds a <strong>belief</strong> about every candidate feature along three axes —
      <em> how important</em>, <em>which depth</em>, and <em>how influential</em> — and it owns the three
      interventions you just met. Crucially, those actions differ in how much they <em>teach</em>: ablation
      is high-information (for exploring), steering is low-information (for confirming). So the
      explore-then-exploit rhythm isn't hand-coded — it falls out of Expected Free Energy.
    </p>

    <StickyScrolly>
      <div slot="graphic">
        <FlowDiagram client:visible testid="dg-loop" ariaLabel="The Active Inference perception-action loop"
          viewW={aiLoop.viewW} viewH={aiLoop.viewH} nodes={aiLoop.nodes} edges={aiLoop.edges} groups={aiLoop.groups}
          caption="The agent's loop: infer → evaluate → act → learn → repeat." />
      </div>
      <div class="step"><h3>1 · Believe</h3><p>From its generative model (A, B, C, D) the agent maintains a probabilistic belief over each feature's hidden state.</p></div>
      <div class="step"><h3>2 · Evaluate</h3><p>For every (feature, action) pair it computes Expected Free Energy — the blend of information gain and preference.</p></div>
      <div class="step"><h3>3 · Act</h3><p>It executes the single best experiment via the <span class="mono">feature_intervention</span> API and measures the KL shift, activation, and connectivity.</p></div>
      <div class="step"><h3>4 · Learn</h3><p>It updates its beliefs <em>and</em> refines its own observation model online with a Dirichlet update — then repeats, sharper than before.</p></div>
    </StickyScrolly>

    <DeepDive title="The POMDP, factor by factor">
      <p>
        Three hidden state factors — importance {`{negligible…high}`}, layer-role {`{early/mid/late}`},
        causal influence {`{weak…strong}`} — and three observation modalities (KL magnitude, activation,
        graph connectivity). The transition model <strong>B(a)</strong> encodes the action semantics:
        ablation has the widest, highest-entropy belief updates (max epistemic value), steering the
        narrowest. That single design choice is what makes exploration emerge. The per-step decision loop:
      </p>
      <div class="step-flow-wrap">
        <FlowDiagram client:visible testid="dg-step" ariaLabel="Per-step decision loop with convergence check"
          viewW={stepFlow.viewW} viewH={stepFlow.viewH} nodes={stepFlow.nodes} edges={stepFlow.edges} groups={stepFlow.groups}
          caption="One step of the agent, from candidate features to the convergence check." />
      </div>
    </DeepDive>
  </ScrollScene>

  <ScrollScene id="explore" num={9} eyebrow="Watch it think" title="Watch the agent explore" wide>
    <p class="lead">
      Theory is cheap; here is a <strong>real run</strong> on a real prompt, twenty experiments deep. Each
      bar is one intervention coloured by the action chosen; below it, the agent's
      <span class="accent-cyan"> belief entropy</span> (its uncertainty) and
      <span class="accent-violet"> expected free energy</span>. Scrub through every step.
    </p>

    <AgentTimeline client:visible />

    <Callout kind="key" label="The signature">
      <p>
        Watch the first move: on Gemma, <strong>every</strong> prompt opens with an
        <span class="accent-amber"> ablation</span> — the high-information probe — and the entropy curve
        drops. Then the agent switches to <span class="accent-violet">steering</span> to exploit what it
        learned. Explore, then exploit, with no schedule telling it to. Across all 100 steps: 5 ablations,
        94 steerings, 1 patch — and every run begins by exploring.
      </p>
    </Callout>
  </ScrollScene>

  {/* ============================== ACT V ============================== */}
  <ActInterstitial act="Act V" title="The Verdict" subtitle="Does borrowing a brain's instincts actually find circuits? Sometimes — and we'll be honest about when." />

  <ScrollScene id="results" num={10} eyebrow="Does it work?" title="Does it find the circuit?" wide>
    <p class="lead">
      To grade discovery we use <strong>bounded oracle efficiency</strong>: how close the agent's chosen
      features come to a perfect oracle that already knows each feature's true effect. 100% = oracle-level.
      Compare methods, tasks, and both models.
    </p>

    <EfficiencyExplorer client:visible />

    <p>
      On <strong>Gemma-2-2B</strong>'s IOI task the agent reaches <strong>{E(HEADLINE.gemmaIoiEff)}</strong>,
      decisively beating random selection. The gradient baseline (EAP) is the one to beat — a genuinely
      strong, cheap ranking — and the agent trades blows with the bandit. On <strong>Llama-3.2-1B</strong>
      it only reaches <strong>{E(HEADLINE.llamaIoiEff)}</strong>, about level with random. We don't hide that.
    </p>
    <DeepDive title="Why is EAP so hard to beat?">
      <p>
        Attribution patching uses gradient information about the true output, so it's a strong static
        prior. The agent's edge is <em>adaptivity under uncertainty</em> — most valuable when signal is
        noisy or the budget tiny, less decisive when one gradient ranking is already near-perfect. Honest
        read: the POMDP reliably beats uninformed search and is competitive with the best heuristics,
        rather than dominating them.
      </p>
    </DeepDive>
  </ScrollScene>

  <ScrollScene id="honesty" num={11} eyebrow="The honest catch" title="The 1255% that isn't what it looks like" wide>
    <p class="lead">
      One number looks spectacular: with steering on, the agent's cumulative effect reaches
      <strong> {Math.round(HEADLINE.gemmaIoiRck)}%</strong> of the ablation oracle on Gemma IOI.
      Super-oracle discovery? <strong>No.</strong> And the data says why.
    </p>

    <RckPanel client:visible />

    <Callout kind="honest">
      <p>
        Every steering-enabled method clears 100% — including <strong>random + steering</strong>. That
        tells you the amplification comes from steering's raw mechanical power, not smarter selection. So
        we report it as an <em>amplification factor</em>, never as an efficiency.
      </p>
    </Callout>

    <p>
      We can pin it down. Take circuit-selected features and matched <em>random</em> controls, scale each
      from ×1.5 to ×10, and count how often the prediction flips:
    </p>

    <SteeringPanel client:visible />

    <div class="hyp-row">
      <HypothesisCard code="H2a" verdict="accepted"
        claim="Amplifying features does change predictions — steering is real."
        stat="binomial p ≈ 2.6 × 10⁻¹² (Gemma, ×10)" />
      <HypothesisCard code="H2b" verdict="rejected"
        claim="Circuit-selected features are only marginally more steerable than random active ones — selectivity is not significant."
        stat="selected vs control p ≈ 0.31 (Gemma, ×10); pooled p ≈ 0.10"
        detail="Much of the steering effect is generic activation scaling, not specific causal control." />
    </div>
  </ScrollScene>

  <ScrollScene id="limits" num={12} eyebrow="Where it breaks" title="Where the method breaks">
    <p class="lead">
      The sharpest failure is the most instructive. On Llama's <strong>multi-step reasoning</strong> task,
      efficiency collapses to <strong>{E(HEADLINE.llamaMultistepEff)}</strong> — below random.
    </p>
    <div class="bigstat-row">
      <div class="bigstat"><span class="bs-num">{E(HEADLINE.gemmaMultistepEff)}</span><span class="bs-lab">Gemma · multi-step</span></div>
      <div class="bigstat warn"><span class="bs-num">{E(HEADLINE.llamaMultistepEff)}</span><span class="bs-lab">Llama · multi-step (3 bins)</span></div>
      <div class="bigstat fix"><span class="bs-num">{E(HEADLINE.llamaMultistepFinebins)}</span><span class="bs-lab">Llama · after the fix (6 bins)</span></div>
    </div>
    <p>
      The cause isn't the theory — it's <strong>resolution</strong>. The agent bins layers into three
      coarse thirds. Gemma has 26 layers; Llama only 16, so three bins smear together the early layers
      where reasoning lives. Refine to six bins and efficiency more than triples, to
      <strong> {E(HEADLINE.llamaMultistepFinebins)}</strong> — confirming the diagnosis.
    </p>
    <Callout kind="honest">
      <p>
        Stated plainly: the default discretisation doesn't transfer to shallow architectures without
        adaptation. The fix is known; the out-of-the-box behaviour still fails. Both belong in the story.
      </p>
    </Callout>
  </ScrollScene>

  <ScrollScene id="domains" num={13} eyebrow="A pattern in the depths" title="Different thoughts, different layers" wide>
    <p class="lead">
      Run the agent across five kinds of knowledge and it stays robust everywhere — but <em>where</em> the
      important features sit depends on the task and the model.
    </p>

    <DomainPanel client:visible />

    <p>
      On <strong>Gemma</strong> the most influential features cluster in <span class="accent-cyan">early</span>
      layers across every domain. On <strong>Llama</strong> the balance tips <span class="accent-amber">later</span>
      for some (geography, maths) and stays early for others (logic, history). There's no single universal
      "facts-live-here" rule — and that's the useful part: rather than assuming a layout, the agent
      <em> surfaces</em> each task's layer fingerprint for inspection. Toggle the models to compare.
    </p>
  </ScrollScene>

  {/* ============================== CODA ============================== */}
  <ScrollScene id="implications" num={14} eyebrow="Why it matters" title="Why this matters">
    <p class="lead">
      The headline isn't a leaderboard win. It's a <strong>reframing</strong>: interpretability under a
      budget is an experimental-design problem, and a theory of the brain gives us a principled way to run
      those experiments.
    </p>
    <ul class="why-list">
      <li><strong>Auditing under budget.</strong> When you can't test everything, spend each probe where it teaches the most.</li>
      <li><strong>Uncertainty as a first-class citizen.</strong> The agent knows what it doesn't know, and acts on it.</li>
      <li><strong>Honest metrics.</strong> Separating discovery (bounded ≤100%) from amplification (unbounded) keeps the claims clean.</li>
      <li><strong>A bridge.</strong> Sparse features, attribution graphs, and active inference can compose into one loop.</li>
    </ul>
    <Callout kind="key" label="In one line">
      <p>Give an AI a neuroscientist's instinct for the next good experiment, and it can start to map its own mind — as long as we read the results honestly.</p>
    </Callout>
  </ScrollScene>

  <ScrollScene id="reading" num={15} eyebrow="Go deeper" title="Read more">
    <p>
      Every number in this essay is computed from the paper's <strong>real</strong> released results — no
      figures were redrawn by hand or invented. Explore the code, reproduce the runs, or read the sources
      behind the ideas.
    </p>
    <CitationList refs={reading} title="References" />
    <p class="foot">
      Written by {AUTHOR.name}. Built with Astro · visuals in D3 &amp; Three.js · all data precomputed from
      the repository's <span class="mono">results/</span>.
    </p>
  </ScrollScene>

  <style>
